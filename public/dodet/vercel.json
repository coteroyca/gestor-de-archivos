{
  "version": 2,
  "public": true,
  "buildCommand": "npm run build",
  "outputDirectory": "./",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "$1"
    },
    {
      "source": "/",
      "destination": "/DODET_v3_JSON_DRIVEN.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.json$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    },
    {
      "source": "/.*\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.md$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
